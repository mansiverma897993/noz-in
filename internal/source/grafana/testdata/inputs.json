{
  "title": "Compatibility fixture",
  "schemaVersion": 41,
  "__inputs": [
    {"name": "DS_PROMETHEUS", "type": "datasource", "pluginId": "prometheus"}
  ],
  "panels": [
    {
      "id": 1,
      "title": "Transformed table",
      "type": "table",
      "datasource": "${DS_PROMETHEUS}",
      "timeFrom": "2h",
      "transformations": [{"id": "joinByField"}],
      "targets": [
        {"refId": "A", "expr": "up", "instant": true, "format": "table"}
      ]
    },
    {
      "id": 2,
      "title": "Runbook",
      "type": "text",
      "options": {"content": "Check the service runbook."}
    }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "query": "label_values(up, instance)",
        "regex": "/source-.+/"
      }
    ]
  }
}
